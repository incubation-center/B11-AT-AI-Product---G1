{
  "name": "backend",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "dev:auth": "PORT=8081 bun run --hot src/auth-service.ts",
    "dev:user": "PORT=8082 bun run --hot src/user-service.ts",
    "dev:store": "PORT=8083 bun run --hot src/store-service.ts",
    "dev:ai": "PORT=8084 bun run --hot src/ai-service.ts",
    "start:auth": "PORT=8081 bun run src/auth-service.ts",
    "start:user": "PORT=8082 bun run src/user-service.ts",
    "start:store": "PORT=8083 bun run src/store-service.ts",
    "start:ai": "PORT=8084 bun run src/ai-service.ts",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@pinecone-database/pinecone": "^7.1.0",
    "@supabase/supabase-js": "^2.57.4",
    "better-auth": "^1.4.18",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.11.10",
    "postgres": "^3.4.8",
    "resend": "^6.9.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.9"
  }
}
